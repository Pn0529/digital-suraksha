PORT=4000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Optional. Set only if you explicitly enable the external URL reputation check in the UI.
GOOGLE_SAFE_BROWSING_API_KEY=
# Optional; defaults to data/digital-suraksha.sqlite.
# DIGITAL_SURAKSHA_DB_PATH=C:\path\outside\the\repository\digital-suraksha.sqlite
# Keep the service-account key outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
